    "@testing-library/user-event": "^14.6.5",
    "@types/node": "22.18.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.3",
